# ---------------------------------------------------------------------------
# Copy this file to .env, replace every "change-me" value, then export the file
# before starting the backend:
#   cp .env.example .env
#   set -a && . ./.env && set +a
# ---------------------------------------------------------------------------

# Docker Compose
MYSQL_PORT=3307
MYSQL_ROOT_PASSWORD=change-me-mysql
REDIS_PASSWORD=change-me-redis

# Spring datasource (DB_PASSWORD must equal MYSQL_ROOT_PASSWORD)
DB_HOST=localhost
DB_PORT=3307
DB_NAME=youlai_admin
DB_USERNAME=root
DB_PASSWORD=change-me-mysql

# Spring Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DATABASE=12
REDIS_PASSWORD=change-me-redis

# Security: generate with `openssl rand -base64 48`
JWT_SECRET=change-me-to-a-random-string-at-least-32-characters

# Optional integrations
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
FILE_STORAGE_PATH=./uploads/
OSS_TYPE=local
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=public
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
WX_MINIAPP_APPID=
WX_MINIAPP_SECRET=
